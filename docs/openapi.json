{
  "openapi": "3.0.3",
  "info": {
    "title": "OpenAgriMap France API",
    "version": "0.2.0",
    "description": "API publique et ouverte d'OpenAgriMap France. Les signalements contribués sont publiés sous licence ODbL (voir /api/export.geojson). Schéma des observations : schema/observation.schema.json.",
    "license": {
      "name": "ODbL-1.0 (données) / MIT (code)",
      "url": "https://opendatacommons.org/licenses/odbl/1-0/"
    }
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8080"
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "summary": "État de santé de l'API",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "reports": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/reports": {
      "get": {
        "summary": "Liste des signalements (filtre optionnel par bbox)",
        "parameters": [
          {
            "name": "bbox",
            "in": "query",
            "description": "minLng,minLat,maxLng,maxLat",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Liste des signalements"
          }
        }
      },
      "post": {
        "summary": "Crée un signalement (validé contre schema/observation.schema.json ; signalements anonymes refusés)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Observation"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Signalement créé (statut pending_moderation)"
          },
          "400": {
            "description": "JSON invalide"
          },
          "409": {
            "description": "Doublon (même contributeur, culture, bioagresseur, à moins de 250 m et 24 h)"
          },
          "422": {
            "description": "Ne respecte pas le schéma (ex : anonyme)"
          }
        }
      }
    },
    "/api/reports/{id}": {
      "patch": {
        "summary": "Modération d'un signalement (prototype local ; à restreindre avec les comptes P1)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": [
                      "pending_moderation",
                      "confirmed",
                      "rejected"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Signalement mis à jour"
          },
          "404": {
            "description": "Inconnu"
          },
          "422": {
            "description": "Statut invalide"
          }
        }
      }
    },
    "/api/reporters/{name}/reputation": {
      "get": {
        "summary": "Réputation + niveau de gamification (Graine → Jardinier → Maraîcher → Agronome) d'un contributeur",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "confirmedReports + level"
          }
        }
      }
    },
    "/api/export.geojson": {
      "get": {
        "summary": "Export open data complet des signalements communautaires (GeoJSON FeatureCollection, ODbL)",
        "responses": {
          "200": {
            "description": "FeatureCollection GeoJSON",
            "content": {
              "application/geo+json": {}
            }
          }
        }
      }
    },
    "/api/proxy/{source}": {
      "get": {
        "summary": "Proxy de cache serveur (10 min) vers les API tierces : soilgrids, openmeteo, gbif, geocode, nominatim",
        "parameters": [
          {
            "name": "source",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "soilgrids",
                "openmeteo",
                "gbif",
                "geocode",
                "nominatim"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Réponse amont (X-Cache: HIT/MISS)"
          },
          "404": {
            "description": "Source inconnue"
          }
        }
      }
    },
    "/api/parcels/{id}": {
      "get": {
        "summary": "Fiche d'identité d'une parcelle (plan §3.5 cas d'usage 1) : assolement, culture en cours, signalements contenus, prix de référence du fermage (quand la source sera branchée)",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Fiche parcelle + recentReports"
          },
          "404": {
            "description": "Parcelle inconnue"
          }
        }
      }
    },
    "/api/neighborhood": {
      "get": {
        "summary": "§3.2-3 Voisinage à risque : foyers de pulvérisation, ruchers < 3 km, élevages proches",
        "parameters": [
          {
            "name": "lat",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "lng",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "radiusKm",
            "in": "query",
            "schema": {
              "type": "number",
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Synthèse voisinage"
          },
          "422": {
            "description": "lat/lng requis"
          }
        }
      }
    },
    "/api/benchmark": {
      "get": {
        "summary": "§3.2-4 Benchmark de territoire : pression par bioagresseur/culture et rendements dans le rayon",
        "parameters": [
          {
            "name": "lat",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "lng",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "radiusKm",
            "in": "query",
            "schema": {
              "type": "number",
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Benchmark"
          },
          "422": {
            "description": "lat/lng requis"
          }
        }
      }
    },
    "/api/proxy/apicarto/{subpath}": {
      "get": {
        "summary": "Pass-through cache (1h) vers ApiCarto IGN — ex: /api/proxy/apicarto/rpg/ilot?bbox=... pour les îlots RPG live (Licence Ouverte 2.0)",
        "parameters": [
          {
            "name": "subpath",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "GeoJSON amont"
          }
        }
      }
    },
    "/api/rpg/parcels": {
      "get": {
        "summary": "Parcelles RPG live pour une bbox (ApiCarto IGN rpg/v2, Licence Ouverte 2.0, cache 1h) — ex: ?bbox=-0.5,47.0,0.5,47.6&annee=2024&_limit=1000",
        "parameters": [
          {
            "name": "bbox",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "minLng,minLat,maxLng,maxLat"
          },
          {
            "name": "annee",
            "in": "query",
            "schema": {
              "type": "string",
              "default": "2024"
            }
          },
          {
            "name": "_limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1000,
              "maximum": 1000
            }
          }
        ],
        "responses": {
          "200": {
            "description": "FeatureCollection GeoJSON (X-Cache HIT/MISS)"
          },
          "422": {
            "description": "bbox invalide"
          }
        }
      }
    },
    "/api/rpg/history": {
      "get": {
        "summary": "Historique RPG multi-millésimes d'un point (ApiCarto rpg/v2, cache) — ex: ?lat=47.25&lng=-0.01&years=2020,2021,2022,2023,2024",
        "parameters": [
          {
            "name": "lat",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "lng",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "years",
            "in": "query",
            "schema": {
              "type": "string",
              "default": "2020,2021,2022,2023,2024"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "{years: [{year, id_parcel, code_cultu, surf_parc}]}"
          },
          "422": {
            "description": "lat/lng requis"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Observation": {
        "type": "object",
        "required": [
          "bioaggressor",
          "severity",
          "crop",
          "location",
          "observedAt",
          "reporter"
        ],
        "properties": {
          "bioaggressor": {
            "type": "string",
            "enum": [
              "mildew",
              "rust",
              "colorado_beetle",
              "aphids",
              "powdery_mildew",
              "box_moth",
              "other"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "crop": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "variety": {
            "type": "string",
            "maxLength": 120
          },
          "stage": {
            "type": "string",
            "maxLength": 80
          },
          "location": {
            "type": "object",
            "required": [
              "lat",
              "lng"
            ],
            "properties": {
              "lat": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              "lng": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              }
            }
          },
          "observedAt": {
            "type": "string",
            "format": "date-time"
          },
          "notes": {
            "type": "string",
            "maxLength": 2000
          },
          "photoUrl": {
            "type": "string",
            "maxLength": 500
          },
          "reporter": {
            "type": "object",
            "required": [
              "role",
              "displayName"
            ],
            "properties": {
              "role": {
                "type": "string",
                "enum": [
                  "gardener",
                  "farmer",
                  "advisor",
                  "researcher",
                  "other"
                ]
              },
              "displayName": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "description": "Obligatoire : les signalements anonymes sont refusés"
              }
            }
          }
        }
      }
    }
  }
}